# Server Configuration
NODE_ENV=development
SERVER_PORT=3000
# ENABLE_CSRF=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Database & Cache
DATABASE_URL=postgresql://postgres:password@localhost:5432/redis_cache_nest

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# Authentication & Security
# openssl command to generate a strong secret: openssl rand -base64 32
JWT_ACCESS_TOKEN_SECRET=your_jwt_secret_here
JWT_REFRESH_TOKEN_SECRET=your_jwt_secret_here
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

COOKIE_SECRET=your_cookie_secret_here
CSRF_SECRET=your_csrf_secret_here

# Swagger API Documentation
API_KEY=jLj0kd1Pv1j3G8PUavFOrQfUTMEPwrZSTKli5/4I/lI=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100  # 100 Req / Min
